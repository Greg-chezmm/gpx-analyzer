# Google Drive sync — copier ce fichier en .env.local et coller le Client ID
VITE_GOOGLE_CLIENT_ID=VOTRE_CLIENT_ID.apps.googleusercontent.com

# Firebase — config de l'app web (console Firebase > Paramètres du projet > Vos applications)
VITE_FIREBASE_API_KEY=VOTRE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Tracestrack — fond de carte "Relief" (clé gratuite sur inscription, tracestrack.com)
VITE_TRACESTRACK_KEY=VOTRE_CLE_API
